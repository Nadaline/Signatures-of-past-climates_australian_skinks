[
* PAUP analysis: SVDQuartets species-tree summary.
* Infer relationships among sampled nuclear genotypes from randomly evaluated quartets with standard bootstrap resampling. The output is an unrooted relationship estimate, not a dated phylogeny.
* Verify that the NEXUS matrix uses the intended 170 individuals and 14,766 informative sites, and retain the recorded random-quartet and bootstrap settings.
]

begin paup;
  execute lampro_ref5_170.nex;
  SVDQuartets
    nthreads=8
    evalQuartets=random
    taxpartition=none
    bootstrap=standard
    nreps=1000;
  savetrees file=svdquartets_ref5_170_random_final.tre format=newick replace=yes;
  quit;
end;
